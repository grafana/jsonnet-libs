{
      "description": "PostgreSQL query performance analysis.            \n",
      "links": [
         {
            "asDropdown": false,
            "includeVars": true,
            "keepTime": true,
            "tags": [
               "postgres",
               "database"
            ],
            "title": "All PostgreSQL dashboards",
            "type": "dashboards"
         }
      ],
      "panels": [
         {
            "collapsed": false,
            "gridPos": {
               "h": 1,
               "w": 0,
               "x": 0,
               "y": 0
            },
            "panels": [ ],
            "title": "Query analysis",
            "type": "row"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Execution time consumption rate per query. Higher values = more resource usage. Run `SELECT query FROM pg_stat_statements WHERE queryid = <query-id>` to see a query's SQL.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "palette-classic"
                  },
                  "custom": {
                     "fillOpacity": 30,
                     "gradientMode": "opacity",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "s"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Top queries by total time"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "s"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 24,
               "x": 0,
               "y": 1
            },
            "options": {
               "legend": {
                  "calcs": [
                     "lastNotNull",
                     "min",
                     "max",
                     "mean"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "sortBy": "Last *",
                  "sortDesc": true
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "topk($topk,\n  sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (\n  rate(pg_stat_statements_seconds_total{job=~\"$job\",postgres_cluster=~\"$postgres_cluster\",cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])\n)\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{ queryid }} ({{ datname }})",
                  "refId": "Top queries by total time"
               }
            ],
            "title": "Query time consumption rate",
            "type": "timeseries"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Average execution time per call. Higher values = slower queries. Run `SELECT query FROM pg_stat_statements WHERE queryid = <query-id>` to see a query's SQL.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "palette-classic"
                  },
                  "custom": {
                     "fillOpacity": 30,
                     "gradientMode": "opacity",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "s"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Slowest queries by mean time"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "s"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 24,
               "x": 0,
               "y": 9
            },
            "options": {
               "legend": {
                  "calcs": [
                     "lastNotNull",
                     "min",
                     "max",
                     "mean"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "sortBy": "Last *",
                  "sortDesc": true
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "topk($topk,\n  sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (\n  sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (pg_stat_statements_seconds_total{job=~\"$job\",postgres_cluster=~\"$postgres_cluster\",cluster=~\"$cluster\",instance=~\"$instance\"})\n/\n(sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (pg_stat_statements_calls_total{job=~\"$job\",postgres_cluster=~\"$postgres_cluster\",cluster=~\"$cluster\",instance=~\"$instance\"}) + 1)\n\n)\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{ queryid }} ({{ datname }})",
                  "refId": "Slowest queries by mean time"
               }
            ],
            "title": "Slowest queries by mean time",
            "type": "timeseries"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Query execution rate. High-frequency queries may benefit from caching. Run `SELECT query FROM pg_stat_statements WHERE queryid = <query-id>` to see a query's SQL.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "palette-classic"
                  },
                  "custom": {
                     "fillOpacity": 30,
                     "gradientMode": "opacity",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "ops"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Most frequent queries"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "ops"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 24,
               "x": 0,
               "y": 17
            },
            "options": {
               "legend": {
                  "calcs": [
                     "lastNotNull",
                     "min",
                     "max",
                     "mean"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "sortBy": "Last *",
                  "sortDesc": true
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "topk($topk,\n  sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (\n  rate(pg_stat_statements_calls_total{job=~\"$job\",postgres_cluster=~\"$postgres_cluster\",cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])\n)\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{ queryid }} ({{ datname }})",
                  "refId": "Most frequent queries"
               }
            ],
            "title": "Most frequent queries",
            "type": "timeseries"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Rows returned per query. High values may indicate missing WHERE/LIMIT clauses. Run `SELECT query FROM pg_stat_statements WHERE queryid = <query-id>` to see a query's SQL.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "palette-classic"
                  },
                  "custom": {
                     "fillOpacity": 30,
                     "gradientMode": "opacity",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "rows/s"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Top queries by rows"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "rows/s"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 24,
               "x": 0,
               "y": 25
            },
            "options": {
               "legend": {
                  "calcs": [
                     "lastNotNull",
                     "min",
                     "max",
                     "mean"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "sortBy": "Last *",
                  "sortDesc": true
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "topk($topk,\n  sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (\n  rate(pg_stat_statements_rows_total{job=~\"$job\",postgres_cluster=~\"$postgres_cluster\",cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])\n)\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{ queryid }} ({{ datname }})",
                  "refId": "Top queries by rows"
               }
            ],
            "title": "Top queries by rows",
            "type": "timeseries"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Query statistics from pg_stat_statements. Shows all queries - sort by any column to analyze. Run `SELECT query FROM pg_stat_statements WHERE queryid = <query-id>` to see a query's SQL.",
            "fieldConfig": {
               "defaults": {
                  "custom": {
                     "filterable": false
                  },
                  "unit": "s"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byName",
                        "options": "Time/s"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "s"
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byName",
                        "options": "Calls/s"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "ops"
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byName",
                        "options": "Rows/s"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "rows/s"
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byName",
                        "options": "Avg time"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "s"
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byName",
                        "options": "Total time"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "s"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 12,
               "w": 24,
               "x": 0,
               "y": 37
            },
            "options": {
               "sortBy": [
                  {
                     "desc": true,
                     "displayName": "Time/s"
                  }
               ]
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (\n  rate(pg_stat_statements_seconds_total{job=~\"$job\",postgres_cluster=~\"$postgres_cluster\",cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])\n)",
                  "format": "table",
                  "instant": true,
                  "legendFormat": "{{ queryid }} ({{ datname }})",
                  "refId": "Top queries by total time"
               },
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (\n  rate(pg_stat_statements_calls_total{job=~\"$job\",postgres_cluster=~\"$postgres_cluster\",cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])\n)",
                  "format": "table",
                  "instant": true,
                  "legendFormat": "{{ queryid }} ({{ datname }})",
                  "refId": "Most frequent queries"
               },
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (\n  rate(pg_stat_statements_rows_total{job=~\"$job\",postgres_cluster=~\"$postgres_cluster\",cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])\n)",
                  "format": "table",
                  "instant": true,
                  "legendFormat": "{{ queryid }} ({{ datname }})",
                  "refId": "Top queries by rows"
               },
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (\n  sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (pg_stat_statements_seconds_total{job=~\"$job\",postgres_cluster=~\"$postgres_cluster\",cluster=~\"$cluster\",instance=~\"$instance\"})\n/\n(sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (pg_stat_statements_calls_total{job=~\"$job\",postgres_cluster=~\"$postgres_cluster\",cluster=~\"$cluster\",instance=~\"$instance\"}) + 1)\n\n)",
                  "format": "table",
                  "instant": true,
                  "legendFormat": "{{ queryid }} ({{ datname }})",
                  "refId": "Slowest queries by mean time"
               },
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "sum by (job,postgres_cluster,cluster,instance,queryid,datname,user) (\n  pg_stat_statements_seconds_total{job=~\"$job\",postgres_cluster=~\"$postgres_cluster\",cluster=~\"$cluster\",instance=~\"$instance\"}\n)",
                  "format": "table",
                  "instant": true,
                  "legendFormat": "{{ queryid }} ({{ datname }})",
                  "refId": "Query total time"
               }
            ],
            "title": "Query statistics",
            "transformations": [
               {
                  "id": "merge"
               },
               {
                  "id": "filterFieldsByName",
                  "options": {
                     "include": {
                        "pattern": "^(?!Time).*$"
                     }
                  }
               },
               {
                  "id": "organize",
                  "options": {
                     "excludeByName": {
                        "cluster": true,
                        "instance": true,
                        "job": true,
                        "postgres_cluster": true
                     },
                     "indexByName": {
                        "Value #Most frequent queries": 4,
                        "Value #Query total time": 7,
                        "Value #Slowest queries by mean time": 6,
                        "Value #Top queries by rows": 5,
                        "Value #Top queries by total time": 3,
                        "datname": 1,
                        "queryid": 0,
                        "user": 2
                     },
                     "renameByName": {
                        "Value #Most frequent queries": "Calls/s",
                        "Value #Query total time": "Total time",
                        "Value #Slowest queries by mean time": "Avg time",
                        "Value #Top queries by rows": "Rows/s",
                        "Value #Top queries by total time": "Time/s",
                        "datname": "Database",
                        "queryid": "Query ID",
                        "user": "User"
                     }
                  }
               },
               {
                  "id": "sortBy",
                  "options": {
                     "fields": { },
                     "sort": [
                        {
                           "desc": true,
                           "field": "Time/s"
                        }
                     ]
                  }
               }
            ],
            "type": "table"
         }
      ],
      "refresh": "1m",
      "schemaVersion": 39,
      "tags": [
         "postgres",
         "database",
         "pg_stat_statements"
      ],
      "templating": {
         "list": [
            {
               "label": "Data source",
               "name": "datasource",
               "query": "prometheus",
               "regex": "",
               "type": "datasource"
            },
            {
               "allValue": ".+",
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "includeAll": true,
               "label": "Job",
               "multi": true,
               "name": "job",
               "query": "label_values({__name__=~\"pg_stat_statements_calls_total\"}, job)",
               "refresh": 2,
               "sort": 1,
               "type": "query"
            },
            {
               "allValue": ".*",
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "includeAll": true,
               "label": "PostgreSQL cluster",
               "multi": true,
               "name": "postgres_cluster",
               "query": "label_values({__name__=~\"pg_stat_statements_calls_total\",job=~\"$job\"}, postgres_cluster)",
               "refresh": 2,
               "sort": 1,
               "type": "query"
            },
            {
               "allValue": ".*",
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "includeAll": true,
               "label": "Cluster",
               "multi": true,
               "name": "cluster",
               "query": "label_values({__name__=~\"pg_stat_statements_calls_total\",job=~\"$job\",postgres_cluster=~\"$postgres_cluster\"}, cluster)",
               "refresh": 2,
               "sort": 1,
               "type": "query"
            },
            {
               "allValue": ".+",
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "includeAll": false,
               "label": "Instance",
               "multi": false,
               "name": "instance",
               "query": "label_values({__name__=~\"pg_stat_statements_calls_total\",job=~\"$job\",postgres_cluster=~\"$postgres_cluster\",cluster=~\"$cluster\"}, instance)",
               "refresh": 2,
               "sort": 1,
               "type": "query"
            },
            {
               "current": {
                  "selected": false,
                  "text": "10",
                  "value": "10"
               },
               "description": "Number of top queries to show in each panel.",
               "label": "Top K queries",
               "name": "topk",
               "options": [
                  {
                     "selected": true,
                     "text": "10",
                     "value": "10"
                  },
                  {
                     "selected": false,
                     "text": "5",
