                  },
                  {
                     "selected": false,
                     "text": "15",
                     "value": "15"
                  },
                  {
                     "selected": false,
                     "text": "20",
                     "value": "20"
                  },
                  {
                     "selected": false,
                     "text": "25",
                     "value": "25"
                  },
                  {
                     "selected": false,
                     "text": "50",
                     "value": "50"
                  }
               ],
               "query": "10 : 10,5 : 5,15 : 15,20 : 20,25 : 25,50 : 50",
               "type": "custom"
            }
         ]
      },
      "time": {
         "from": "now-1h",
         "to": "now"
      },
      "timezone": "",
      "title": "PostgreSQL query performance",
      "uid": "postgres-queries"
   }