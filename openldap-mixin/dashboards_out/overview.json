         {
            "datasource": {
               "type": "prometheus",
               "uid": "${prometheus_datasource}"
            },
            "description": "The total time since the LDAP server was last started.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "text",
                     "mode": "fixed"
                  },
                  "min": 0,
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [
                        {
                           "color": "#5794f2",
                           "value": null
                        }
                     ]
                  },
                  "unit": "s"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Uptime"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "s"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 6,
               "w": 8,
               "x": 0,
               "y": 1
            },
            "id": 2,
            "options": {
               "graphMode": "none",
               "reduceOptions": {
                  "calcs": [
                     "lastNotNull"
                  ]
               },
               "textMode": "value"
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${prometheus_datasource}"
                  },
                  "expr": "openldap_monitored_object{job=~\"$job\",instance=~\"$instance\", dn=\"cn=Uptime,cn=Time,cn=Monitor\"}",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}}",
                  "refId": "Uptime"
               }
            ],
            "title": "Uptime",
            "type": "stat"
         },
