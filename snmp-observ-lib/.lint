exclusions:
  template-instance-rule:
    reason: "These dashboards are designed to be single instance"
    entries:
      - dashboard: SNMP overview
  panel-title-description-rule:
    reason: "The title fully describes these panels"
    entries:
      - panel: System name
      - panel: Version
      - panel: CPU usage
      - panel: Memory utilization
      - panel: Receive/transmit power
      - panel: Fan speed
      - panel: Network devices
      - panel: Interfaces
