         {
            "datasource": {
               "type": "prometheus",
               "uid": "${prometheus_datasource}"
            },
            "description": "Success rate of backups within the instance in the past hour.",
            "fieldConfig": {
               "defaults": {
                  "thresholds": {
                     "steps": [
                        {
                           "color": "super-light-red",
                           "value": 0.5
                        },
                        {
                           "color": "super-light-green",
                           "value": 0.90000000000000002
                        }
                     ]
                  },
                  "unit": "percentunit"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Backup success rate (1 hour)"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "percentunit"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 4,
               "w": 4,
               "x": 0,
               "y": 1
            },
            "id": 2,
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${prometheus_datasource}"
                  },
                  "expr": "avg by (instance) (label_replace(increase(velero_backup_success_total{job=\"integrations/velero\",job=~\"$job\",cluster=~\"$cluster\",instance=~\"$instance\",schedule=~\"$schedule\"}[1h]), \"schedule\", \"none\", \"schedule\", \"^$\") / label_replace(increase(velero_backup_attempt_total{job=\"integrations/velero\",job=~\"$job\",cluster=~\"$cluster\",instance=~\"$instance\",schedule=~\"$schedule\"}[1h]), \"schedule\", \"none\", \"schedule\", \"^$\") >  0)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{schedule}}",
                  "refId": "Backup success rate (1 hour)"
               }
            ],
            "title": "Backup success rate (1 hour)",
            "type": "gauge"
         },
