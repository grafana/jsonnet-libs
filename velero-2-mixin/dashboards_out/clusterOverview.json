         {
            "datasource": {
               "type": "prometheus",
               "uid": "${prometheus_datasource}"
            },
            "description": "Number of successful backups across all clusters.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "text",
                     "mode": "fixed"
                  },
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [
                        {
                           "color": "#5794f2",
                           "value": null
                        }
                     ]
                  },
                  "unit": ""
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Successful backups / $__interval"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": ""
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 4,
               "w": 4,
               "x": 0,
               "y": 1
            },
            "id": 2,
            "options": {
               "graphMode": "area",
               "reduceOptions": {
                  "calcs": [
                     "lastNotNull"
                  ]
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${prometheus_datasource}"
                  },
                  "expr": "sum by (cluster) (\n  increase(velero_backup_success_total{job=~\"$job\",cluster=~\"$cluster\"}[$__interval:] offset -$__interval)\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "Backups",
                  "refId": "Successful backups / $__interval"
               }
            ],
            "title": "Successful backups / $__interval",
            "type": "stat"
         },
