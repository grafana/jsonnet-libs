{
      "annotations": {
         "list": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "enable": true,
               "expr": "count by (job,instance, alertname) (ALERTS{alertstate=\"firing\", severity=\"critical\", job=~\"$job\",instance=~\"$instance\"})",
               "iconColor": "#ff7383",
               "name": "Critical alert",
               "tagKeys": "job,instance",
               "textFormat": "{{alertname}}",
               "titleFormat": "Critical alert"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "enable": true,
               "expr": "count by (job,instance, alertname) (ALERTS{alertstate=\"firing\", severity=\"warning\", job=~\"$job\",instance=~\"$instance\"})",
               "hide": true,
               "iconColor": "#fade2a",
               "name": "Warning alert",
               "tagKeys": "job,instance",
               "textFormat": "{{alertname}}",
               "titleFormat": "Warning alert"
            }
         ]
      },
      "editable": false,
      "links": [ ],
      "panels": [
         {
            "collapsed": false,
            "gridPos": {
               "h": 1,
               "w": 0,
               "x": 0,
               "y": 0
            },
            "panels": [ ],
            "title": "Overview",
            "type": "row"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Share of each disk's capacity that is used.",
            "fieldConfig": {
               "defaults": {
                  "max": 1,
                  "min": 0,
                  "thresholds": {
                     "steps": [
                        {
                           "color": "green",
                           "value": null
                        },
                        {
                           "color": "red",
                           "value": 0.80000000000000004
                        }
                     ]
                  },
                  "unit": "percentunit"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Storage used ratio"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "percentunit"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 7,
               "w": 6,
               "x": 0,
               "y": 1
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "sum by (job,instance,disk) (disk_storage_used{job=~\"$job\",instance=~\"$instance\",disk=~\"$disk\"})\n/\nsum by (job,instance,disk) (disk_storage_total{job=~\"$job\",instance=~\"$instance\",disk=~\"$disk\"})\n",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}} {{disk}}",
                  "refId": "Storage used ratio"
               }
            ],
            "title": "Storage used",
            "type": "gauge"
         },
         {
            "datasource": {
               "type": "prometheus",
