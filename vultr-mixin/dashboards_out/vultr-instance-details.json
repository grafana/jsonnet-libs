               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "avg by (job,region,label,interface) (\n  vultr_instance_network_rx_bytes_per_sec{job=~\"$job\",region=~\"$region\",label=~\"$label\"}\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{label}} {{interface}} receive",
                  "refId": "Network receive"
               },
               {
                  "datasource": {
                     "type": "prometheus",
