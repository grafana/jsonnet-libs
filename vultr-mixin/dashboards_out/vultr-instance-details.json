            "title": "Compute",
            "type": "row"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Current CPU usage of the instance.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "continuous-BlYlRd"
                  },
                  "custom": {
                     "fillOpacity": 30,
                     "gradientMode": "scheme",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "decimals": 1,
                  "max": 100,
                  "min": 0,
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "percent"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "CPU usage"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "percent"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 12,
               "x": 0,
               "y": 1
            },
            "id": 2,
            "options": {
               "legend": {
                  "calcs": [ ],
                  "displayMode": "list"
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "avg by (job,region,label) (\n  vultr_instance_cpu_usage_percent{job=~\"$job\",region=~\"$region\",label=~\"$label\"}\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{label}}: CPU",
                  "refId": "CPU usage"
               }
            ],
            "title": "CPU usage",
            "type": "timeseries"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Disk read and write operations per second. Writes are shown on the negative y-axis.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "palette-classic"
                  },
                  "custom": {
                     "axisCenteredZero": true,
                     "axisLabel": "write(-) | read(+)",
                     "fillOpacity": 30,
                     "gradientMode": "opacity",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "iops"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byRegexp",
                        "options": "/write/"
                     },
                     "properties": [
                        {
                           "id": "custom.transform",
                           "value": "negative-Y"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 12,
               "x": 12,
               "y": 1
            },
            "id": 3,
            "options": {
               "legend": {
                  "calcs": [ ],
                  "displayMode": "list"
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "avg by (job,region,label) (\n  vultr_instance_disk_read_ops_per_sec{job=~\"$job\",region=~\"$region\",label=~\"$label\"}\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{label}} read",
                  "refId": "Disk read operations"
               },
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "avg by (job,region,label) (\n  vultr_instance_disk_write_ops_per_sec{job=~\"$job\",region=~\"$region\",label=~\"$label\"}\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{label}} write",
                  "refId": "Disk write operations"
               }
            ],
            "title": "Disk operations",
            "type": "timeseries"
         },
         {
