                     "fixedColor": "#5794f2",
                     "mode": "palette-classic"
                  },
                  "custom": {
                     "fillOpacity": 30,
                     "gradientMode": "opacity",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "decimals": 1,
                  "noValue": "No traffic",
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "Bps"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Network receive"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "Bps"
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Network transmit"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "Bps"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 12,
               "x": 0,
               "y": 10
            },
            "id": 5,
