         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Bandwidth used in the current billing period compared with the allowance. The totals reset at the start of each billing period.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "palette-classic"
                  },
                  "custom": {
                     "fillOpacity": 30,
                     "gradientMode": "opacity",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "decbytes"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Outbound bandwidth this billing period"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "decbytes"
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Inbound bandwidth this billing period"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "decbytes"
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Bandwidth allowance"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "decbytes"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 12,
               "x": 12,
               "y": 10
