            "id": 6,
            "options": {
               "legend": {
                  "calcs": [ ],
                  "displayMode": "list"
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "max by (job,region,label) (vultr_instance_bandwidth_tx_bytes_total{job=~\"$job\",region=~\"$region\",label=~\"$label\"})",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{label}} outbound",
                  "refId": "Outbound bandwidth this billing period"
               },
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "max by (job,region,label) (vultr_instance_bandwidth_rx_bytes_total{job=~\"$job\",region=~\"$region\",label=~\"$label\"})",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{label}} inbound",
                  "refId": "Inbound bandwidth this billing period"
               },
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "avg by (job,region,label) (\n  vultr_instance_bandwidth_allowed_bytes{job=~\"$job\",region=~\"$region\",label=~\"$label\"}\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{label}} allowance",
                  "refId": "Bandwidth allowance"
               }
            ],
            "title": "Bandwidth this billing period",
            "type": "timeseries"
         },
