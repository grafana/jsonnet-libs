exclusions:
  template-job-rule:
    reason: "Prometheus datasource variable is being named as prometheus_datasource now while linter expects 'datasource'"
  panel-datasource-rule:
    reason: "Modern mixins use signal-based architecture where datasource references are handled by the framework"
  template-datasource-rule:
    reason: "Based on new convention we are using the variable name prometheus_datasource where as linter expects 'datasource'"
  template-instance-rule:
    reason: "Both drilldown dashboards pin one of test_name/node_name instead of instance"
  target-job-rule:
    reason: "mixtool upgrade made this rule stricter. TODO: Fix errors and remove the warning exclusion"
  panel-units-rule:
    reason: "Panels are better suited with custom units"
    entries:
      - panel: "Network connections"
      - panel: "Hosts contacted"
      - panel: "Cache access"
      - panel: "Redirects"
      - panel: "Top average redirects by tests"
      - panel: "Top average redirects by nodes"
      - panel: "Top errors by tests"
