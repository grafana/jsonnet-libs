         {
            "datasource": {
               "type": "prometheus",
               "uid": "${prometheus_datasource}"
            },
            "description": "Reports the status of the Neutron networking service.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "fixed"
                  },
                  "mappings": [
                     {
                        "options": {
                           "0": {
                              "color": "red",
                              "index": 1,
                              "text": "Down"
                           },
                           "1": {
                              "color": "green",
                              "index": 0,
                              "text": "Up"
                           }
                        },
                        "type": "value"
                     }
                  ],
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [
                        {
                           "color": "#5794f2",
                           "value": null
                        }
                     ]
                  },
                  "unit": "string"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Neutron status"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "string"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 6,
               "x": 0,
               "y": 0
            },
            "id": 1,
            "options": {
               "graphMode": "none"
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${prometheus_datasource}"
                  },
                  "expr": "openstack_neutron_up{job=~\"$job\",instance=~\"$instance\"}",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}}",
                  "refId": "Neutron status"
               }
            ],
            "title": "Neutron status",
            "type": "stat"
         },
