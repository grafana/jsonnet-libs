{
      "annotations": {
         "list": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${prometheus_datasource}"
               },
               "enable": true,
               "expr": "(min by (job,instance, os_description) (min_over_time(timestamp(target_info{os_description!=\"\", job!=\"\",job=~\"$job\",instance=~\"$instance\"})[$__range:1m] @ end()))\nunless on (job,instance, os_description) last_over_time(target_info{os_description!=\"\", job!=\"\",job=~\"$job\",instance=~\"$instance\"}[1d] @ start())\nand on (job,instance) last_over_time(target_info{os_description!=\"\", job!=\"\",job=~\"$job\",instance=~\"$instance\"}[1d] @ start())\n) * 1000 > $__from < $__to",
               "hide": true,
               "iconColor": "light-blue",
               "name": "OS or kernel change",
               "step": "5m",
               "tagKeys": "job,instance",
               "textFormat": "{{os_description}}",
               "titleFormat": "OS or kernel change",
               "useValueForTime": "on"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${prometheus_datasource}"
               },
               "enable": true,
               "expr": "(max by (job,instance) (round(timestamp(system_uptime_seconds{job!=\"\",job=~\"$job\",instance=~\"$instance\"}) - system_uptime_seconds{job!=\"\",job=~\"$job\",instance=~\"$instance\"}, 60))\nor\nmax by (job,instance) (round(timestamp(system_uptime{job!=\"\",job=~\"$job\",instance=~\"$instance\"}) - system_uptime{job!=\"\",job=~\"$job\",instance=~\"$instance\"}, 60))) * 1000 > $__from < $__to",
               "hide": true,
               "iconColor": "#fade2a",
               "name": "Reboot",
               "tagKeys": "job,instance",
               "titleFormat": "Reboot",
               "useValueForTime": "on"
            }
         ]
      },
      "links": [
         {
            "includeVars": true,
            "keepTime": true,
            "title": "Back to Hostmetrics / fleet overview",
            "type": "link",
            "url": "/d/hostmetrics-fleet"
         },
         {
            "includeVars": true,
            "keepTime": true,
            "title": "Back to Hostmetrics / host summary",
            "type": "link",
            "url": "/d/hostmetrics-nodes"
         },
         {
            "asDropdown": true,
            "includeVars": true,
            "keepTime": true,
            "tags": [
               "hostmetrics"
            ],
            "title": "All Hostmetrics / dashboards",
            "type": "dashboards"
         }
      ],
      "panels": [
         {
            "datasource": {
               "type": "loki",
               "uid": "${loki_datasource}"
            },
            "description": "Logs volume grouped by \"detected_level\" label.",
            "fieldConfig": {
               "defaults": {
                  "custom": {
                     "drawStyle": "bars",
                     "fillOpacity": 50,
                     "stacking": {
                        "mode": "normal"
                     }
                  },
                  "unit": "none"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byRegexp",
                        "options": "(E|e)merg|(F|f)atal|(A|a)lert|(C|c)rit.*"
                     },
                     "properties": [
                        {
                           "id": "color",
                           "value": {
                              "fixedColor": "purple",
                              "mode": "fixed"
                           }
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byRegexp",
                        "options": "(E|e)(rr.*|RR.*)"
                     },
                     "properties": [
                        {
                           "id": "color",
                           "value": {
                              "fixedColor": "red",
                              "mode": "fixed"
                           }
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byRegexp",
                        "options": "(W|w)(arn.*|ARN.*|rn|RN)"
                     },
                     "properties": [
                        {
                           "id": "color",
                           "value": {
                              "fixedColor": "orange",
                              "mode": "fixed"
                           }
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byRegexp",
                        "options": "(N|n)(otice|ote)|(I|i)(nf.*|NF.*)"
                     },
                     "properties": [
                        {
                           "id": "color",
                           "value": {
                              "fixedColor": "green",
                              "mode": "fixed"
                           }
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byRegexp",
                        "options": "dbg.*|DBG.*|(D|d)(EBUG|ebug)"
                     },
                     "properties": [
                        {
                           "id": "color",
                           "value": {
                              "fixedColor": "blue",
                              "mode": "fixed"
                           }
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byRegexp",
                        "options": "(T|t)(race|RACE)"
                     },
                     "properties": [
                        {
                           "id": "color",
                           "value": {
                              "fixedColor": "light-blue",
                              "mode": "fixed"
                           }
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byRegexp",
                        "options": "logs"
                     },
                     "properties": [
                        {
                           "id": "color",
                           "value": {
                              "fixedColor": "text",
                              "mode": "fixed"
                           }
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 6,
               "w": 24,
               "x": 0,
               "y": 0
            },
            "id": 1,
            "maxDataPoints": 100,
            "options": {
               "tooltip": {
                  "hideZeros": true,
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.0.0",
            "targets": [
               {
                  "datasource": {
                     "type": "loki",
                     "uid": "${loki_datasource}"
                  },
                  "expr": "sum by (detected_level) (count_over_time({service_name!=\"\",service_name=~\"$service_name\",service_instance_id=~\"$instance\"}\n|~ \"$regex_search\"\n\n[$__auto]))\n",
                  "legendFormat": "{{ detected_level }}"
               }
            ],
            "title": "Logs volume",
            "transformations": [
               {
                  "id": "renameByRegex",
                  "options": {
                     "regex": "Value",
                     "renamePattern": "logs"
                  }
               }
            ],
            "type": "timeseries"
         },
         {
            "datasource": {
               "type": "datasource",
               "uid": "-- Mixed --"
            },
            "gridPos": {
               "h": 18,
               "w": 24,
               "x": 0,
               "y": 18
            },
            "id": 2,
            "options": {
               "dedupStrategy": "exact",
               "enableLogDetails": true,
               "prettifyLogMessage": true,
               "showTime": false,
               "wrapLogMessage": false
            },
            "pluginVersion": "v11.0.0",
            "targets": [
               {
                  "datasource": {
                     "type": "loki",
                     "uid": "${loki_datasource}"
                  },
                  "expr": "{service_name!=\"\",service_name=~\"$service_name\",service_instance_id=~\"$instance\"} \n|~ \"$regex_search\"\n\n| label_format timestamp=\"{{__timestamp__}}\"\n| line_format `{{ if eq \"[[instance]]\" \".*\" }}{{alignLeft 25 .service_instance_id}}|{{end}} {{__line__}}`\n\n"
               }
            ],
            "title": "Logs",
            "type": "logs"
         }
      ],
      "refresh": "1m",
      "schemaVersion": 39,
      "tags": [
         "hostmetrics"
      ],
      "templating": {
         "list": [
            {
               "label": "Loki data source",
               "name": "loki_datasource",
               "query": "loki",
               "regex": "",
               "type": "datasource"
            },
            {
               "allValue": ".*",
               "datasource": {
                  "type": "loki",
                  "uid": "${loki_datasource}"
               },
               "includeAll": true,
               "label": "Service name",
               "multi": true,
               "name": "service_name",
               "query": "label_values({service_name!=\"\"}, service_name)",
               "refresh": 2,
               "sort": 1,
               "type": "query"
            },
            {
               "allValue": ".*",
               "datasource": {
                  "type": "loki",
                  "uid": "${loki_datasource}"
               },
               "includeAll": true,
               "label": "Instance",
               "multi": true,
               "name": "instance",
               "query": "label_values({service_name!=\"\",service_name=~\"$service_name\"}, service_instance_id)",
               "refresh": 2,
               "sort": 1,
               "type": "query"
            },
            {
               "current": {
                  "selected": false,
                  "text": "",
                  "value": ""
               },
               "label": "Regex search",
               "name": "regex_search",
               "options": [
                  {
                     "selected": true,
                     "text": "",
                     "value": ""
                  }
               ],
               "query": "",
               "type": "textbox"
            },
            {
               "hide": 2,
               "label": "Prometheus data source",
               "name": "prometheus_datasource",
               "query": "prometheus",
               "regex": "",
               "type": "datasource"
            },
            {
               "allValue": ".+",
               "datasource": {
                  "type": "prometheus",
                  "uid": "${prometheus_datasource}"
               },
               "hide": 2,
               "includeAll": true,
               "label": "Job",
               "multi": true,
               "name": "job",
               "query": "label_values({__name__=~\"system_uptime|system_uptime_seconds\",job!=\"\"}, job)",
               "refresh": 2,
               "sort": 1,
               "type": "query"
            }
         ]
      },
      "time": {
         "from": "now-1h",
         "to": "now"
      },
      "timezone": "",
      "title": "Hostmetrics / logs",
      "uid": "hostmetrics-logs"
   }