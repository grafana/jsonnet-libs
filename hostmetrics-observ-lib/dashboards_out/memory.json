{
      "annotations": {
         "list": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "enable": true,
               "expr": "changes(sum by (job,instance) (group by (job,instance, os_description) (target_info{job=~\".+\",job=~\"$job\",instance=~\"$instance\", os_description!=\"\"}))[$__interval:1m] offset -$__interval) > 1",
               "hide": true,
               "iconColor": "light-blue",
               "name": "OS or kernel change",
               "step": "5m",
               "tagKeys": "job,instance",
               "textFormat": "",
               "titleFormat": "OS or kernel change"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "enable": true,
               "expr": "(max by (job,instance) (round(timestamp(system_uptime_seconds{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}) - system_uptime_seconds{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}, 60))\nor\nmax by (job,instance) (round(timestamp(system_uptime{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}) - system_uptime{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}, 60))) * 1000 > $__from < $__to",
               "hide": true,
               "iconColor": "#fade2a",
               "name": "Reboot",
               "tagKeys": "job,instance",
               "titleFormat": "Reboot",
               "useValueForTime": "on"
            }
         ]
      },
      "links": [
         {
            "includeVars": true,
            "keepTime": true,
            "title": "Back to Hostmetrics / fleet overview",
            "type": "link",
            "url": "/d/hostmetrics-fleet"
         },
         {
            "includeVars": true,
            "keepTime": true,
            "title": "Back to Hostmetrics / overview",
            "type": "link",
            "url": "/d/hostmetrics-nodes"
         },
         {
            "asDropdown": true,
            "includeVars": true,
            "keepTime": true,
            "tags": [
               "hostmetrics"
            ],
            "title": "All Hostmetrics / dashboards",
            "type": "dashboards"
         }
      ],
      "panels": [
         {
            "collapsed": false,
            "gridPos": {
               "h": 1,
               "w": 0,
               "x": 0,
               "y": 0
            },
            "id": 1,
            "panels": [ ],
            "title": "Utilization",
            "type": "row"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Share of physical memory in use.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "continuous-BlYlRd"
                  },
                  "custom": {
                     "fillOpacity": 30,
                     "gradientMode": "scheme",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "decimals": 1,
                  "max": 100,
                  "min": 0,
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "percent"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Memory usage"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "percent"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 12,
               "x": 0,
               "y": 1
            },
            "id": 2,
            "options": {
               "legend": {
                  "calcs": [ ],
                  "displayMode": "list"
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "100 * (\n  sum by (job,instance) (\n  system_memory_utilization_ratio{job=~\".+\",job=~\"$job\",instance=~\"$instance\", state=\"used\"}\n)\n)\nor\n100 * (\n  sum by (job,instance) (\n  system_memory_utilization{job=~\".+\",job=~\"$job\",instance=~\"$instance\", state=\"used\"}\n)\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}}",
                  "refId": "Memory usage"
               }
            ],
            "title": "Memory usage",
            "type": "timeseries"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Physical memory broken down by state.",
