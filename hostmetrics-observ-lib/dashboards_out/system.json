{
      "annotations": {
         "list": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "enable": true,
               "expr": "changes(sum by (job,instance) (group by (job,instance, os_description) (target_info{job=~\".+\",job=~\"$job\",instance=~\"$instance\", os_description!=\"\"}))[$__interval:1m] offset -$__interval) > 1",
               "hide": true,
               "iconColor": "light-blue",
               "name": "OS or kernel change",
               "step": "5m",
               "tagKeys": "job,instance",
               "textFormat": "",
               "titleFormat": "OS or kernel change"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "enable": true,
               "expr": "(max by (job,instance) (round(timestamp(system_uptime_seconds{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}) - system_uptime_seconds{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}, 60))\nor\nmax by (job,instance) (round(timestamp(system_uptime{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}) - system_uptime{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}, 60))) * 1000 > $__from < $__to",
               "hide": true,
               "iconColor": "#fade2a",
               "name": "Reboot",
               "tagKeys": "job,instance",
               "titleFormat": "Reboot",
               "useValueForTime": "on"
            }
         ]
      },
      "links": [
         {
            "includeVars": true,
            "keepTime": true,
            "title": "Back to Hostmetrics / fleet overview",
            "type": "link",
            "url": "/d/hostmetrics-fleet"
         },
         {
            "includeVars": true,
            "keepTime": true,
            "title": "Back to Hostmetrics / overview",
            "type": "link",
            "url": "/d/hostmetrics-nodes"
         },
         {
            "asDropdown": true,
            "includeVars": true,
            "keepTime": true,
            "tags": [
               "hostmetrics"
            ],
            "title": "All Hostmetrics / dashboards",
            "type": "dashboards"
         }
      ],
      "panels": [
         {
            "collapsed": false,
            "gridPos": {
               "h": 1,
               "w": 0,
               "x": 0,
               "y": 0
            },
            "id": 1,
            "panels": [ ],
            "title": "Utilization",
            "type": "row"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Share of CPU time spent working: not idle, and not waiting for I/O.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "continuous-BlYlRd"
                  },
                  "custom": {
                     "fillOpacity": 30,
                     "gradientMode": "scheme",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "decimals": 1,
                  "max": 100,
                  "min": 0,
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "percent"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "CPU usage"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "percent"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 12,
               "x": 0,
               "y": 1
            },
            "id": 2,
            "options": {
               "legend": {
                  "calcs": [ ],
                  "displayMode": "list"
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "100 * (1 - avg by (job,instance) (sum by (job,instance, cpu) (system_cpu_utilization_ratio{job=~\".+\",job=~\"$job\",instance=~\"$instance\", state=~\"idle|wait\"})))\nor\n100 * (1 - avg by (job,instance) (sum by (job,instance, cpu) (system_cpu_utilization{job=~\".+\",job=~\"$job\",instance=~\"$instance\", state=~\"idle|wait\"})))",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}}",
                  "refId": "CPU usage"
               }
            ],
            "title": "CPU usage",
            "type": "timeseries"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "CPU time share per state, excluding idle.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "palette-classic"
                  },
                  "custom": {
                     "fillOpacity": 80,
                     "gradientMode": "opacity",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never",
                     "stacking": {
                        "mode": "normal"
                     }
                  },
                  "max": 100,
                  "min": 0,
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "percent"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byName",
                        "options": "idle"
                     },
                     "properties": [
                        {
                           "id": "color",
                           "value": {
                              "fixedColor": "light-blue",
                              "mode": "fixed"
                           }
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byName",
                        "options": "interrupt"
                     },
                     "properties": [
                        {
                           "id": "color",
                           "value": {
                              "fixedColor": "light-purple",
                              "mode": "fixed"
                           }
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byName",
                        "options": "user"
                     },
                     "properties": [
                        {
                           "id": "color",
                           "value": {
                              "fixedColor": "light-orange",
                              "mode": "fixed"
                           }
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byRegexp",
                        "options": "system|privileged"
                     },
                     "properties": [
                        {
                           "id": "color",
                           "value": {
                              "fixedColor": "light-red",
                              "mode": "fixed"
                           }
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 12,
               "x": 12,
               "y": 1
            },
            "id": 3,
            "options": {
               "legend": {
                  "calcs": [ ],
                  "displayMode": "list"
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "100 * (\n  avg by (job,instance,state) (\n  system_cpu_utilization_ratio{job=~\".+\",job=~\"$job\",instance=~\"$instance\", state!=\"idle\"}\n)\n)\nor\n100 * (\n  avg by (job,instance,state) (\n  system_cpu_utilization{job=~\".+\",job=~\"$job\",instance=~\"$instance\", state!=\"idle\"}\n)\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}} {{state}}",
                  "refId": "CPU usage by mode"
               }
            ],
            "title": "CPU usage by mode",
            "type": "timeseries"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "Share of time each core spends working: not idle, and not waiting for I/O.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "continuous-BlYlRd"
                  },
                  "custom": {
                     "fillOpacity": 30,
                     "gradientMode": "scheme",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "decimals": 1,
                  "max": 100,
                  "min": 0,
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "percent"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "CPU usage per core"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "percent"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 12,
               "x": 0,
               "y": 9
            },
            "id": 4,
            "options": {
               "legend": {
                  "calcs": [ ],
                  "displayMode": "list"
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "100 * (1 - sum by (job,instance, cpu) (system_cpu_utilization_ratio{job=~\".+\",job=~\"$job\",instance=~\"$instance\", state=~\"idle|wait\"}))\nor\n100 * (1 - sum by (job,instance, cpu) (system_cpu_utilization{job=~\".+\",job=~\"$job\",instance=~\"$instance\", state=~\"idle|wait\"}))",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}} {{cpu}}",
                  "refId": "CPU usage per core"
               }
            ],
            "title": "CPU usage per core",
            "type": "timeseries"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "CPU seconds spent per second in each state, in cores.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "palette-classic"
                  },
                  "custom": {
                     "fillOpacity": 30,
                     "gradientMode": "opacity",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "short"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "CPU time by mode"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "short"
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 12,
               "x": 12,
               "y": 9
            },
            "id": 5,
            "options": {
               "legend": {
                  "calcs": [ ],
                  "displayMode": "list"
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "sum by (job,instance,state) (\n  rate(system_cpu_time_seconds_total{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])\n)\nor\nsum by (job,instance,state) (\n  rate(system_cpu_time{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}}: CPU time ({{state}})",
                  "refId": "CPU time by mode"
               }
            ],
            "title": "CPU time by mode",
            "type": "timeseries"
         },
         {
            "collapsed": false,
            "gridPos": {
               "h": 1,
               "w": 0,
               "x": 0,
               "y": 17
            },
            "id": 6,
            "panels": [ ],
            "title": "System",
            "type": "row"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "description": "1m (max): System load over 1 minute.  \n\n5m (max): System load over 5 minutes.  \n\n15m (max): System load over 15 minutes.  \n\nCores (max): Logical cores available.",
            "fieldConfig": {
               "defaults": {
                  "color": {
                     "fixedColor": "#5794f2",
                     "mode": "palette-classic"
                  },
                  "custom": {
                     "fillOpacity": 0,
                     "gradientMode": "opacity",
                     "lineInterpolation": "smooth",
                     "lineWidth": 2,
                     "showPoints": "never"
                  },
                  "min": 0,
                  "thresholds": {
                     "mode": "absolute",
                     "steps": [ ]
                  },
                  "unit": "short"
               },
               "overrides": [
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Load average 1m"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "short"
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Load average 5m"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "short"
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "Load average 15m"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "short"
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byFrameRefID",
                        "options": "CPU cores"
                     },
                     "properties": [
                        {
                           "id": "unit",
                           "value": "short"
                        }
                     ]
                  },
                  {
                     "matcher": {
                        "id": "byRegexp",
                        "options": ".*Cores.*"
                     },
                     "properties": [
                        {
                           "id": "color",
                           "value": {
                              "fixedColor": "#ffb357",
                              "mode": "fixed"
                           }
                        },
                        {
                           "id": "custom.fillOpacity",
                           "value": 0
                        },
                        {
                           "id": "custom.lineStyle",
                           "value": {
                              "dash": [
                                 10,
                                 10
                              ],
                              "fill": "dash"
                           }
                        }
                     ]
                  }
               ]
            },
            "gridPos": {
               "h": 8,
               "w": 12,
               "x": 0,
               "y": 18
            },
            "id": 7,
            "options": {
               "legend": {
                  "calcs": [ ],
                  "displayMode": "list"
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "max by (job,instance) (\n  system_cpu_load_average_1m{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}}: 1m",
                  "refId": "Load average 1m"
               },
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "max by (job,instance) (\n  system_cpu_load_average_5m{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}}: 5m",
                  "refId": "Load average 5m"
               },
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "max by (job,instance) (\n  system_cpu_load_average_15m{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}}: 15m",
                  "refId": "Load average 15m"
               },
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "max by (job,instance) (\n  system_cpu_logical_count{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}}: Cores",
                  "refId": "CPU cores"
               }
            ],
            "title": "Load average",
            "type": "timeseries"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
