               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
               {
                  "datasource": {
                     "type": "prometheus",
                     "uid": "${datasource}"
                  },
                  "expr": "avg by (job,instance,cpu) (\n  system_cpu_frequency_hertz{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}\n)\nor\navg by (job,instance,cpu) (\n  system_cpu_frequency{job=~\".+\",job=~\"$job\",instance=~\"$instance\"}\n)",
                  "format": "time_series",
                  "instant": false,
                  "legendFormat": "{{instance}}: Frequency ({{cpu}})",
                  "refId": "CPU frequency"
               }
            ],
