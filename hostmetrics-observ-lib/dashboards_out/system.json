            "gridPos": {
               "h": 8,
               "w": 24,
               "x": 0,
               "y": 26
            },
            "id": 9,
            "options": {
               "legend": {
                  "calcs": [ ],
                  "displayMode": "list"
               },
               "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
               }
            },
            "pluginVersion": "v11.4.0",
            "targets": [
