local common = import './common.libsonnet';

function(this)
  // The hostmetrics receiver reports paging operations and faults multiplied by 4096.
  local pagingCount = ['(', ') / 4096'];
  {
    filteringSelector: this.filteringSelector,
    groupLabels: this.groupLabels,
    instanceLabels: this.instanceLabels,
    enableLokiLogs: this.enableLokiLogs,
    aggLevel: 'instance',
    aggFunction: 'max',
    discoveryMetric: common.discoveryMetric,
    signals: {
      memoryUsagePercent: {
        name: 'Memory usage',
        nameShort: 'Memory',
        type: 'gauge',
        aggFunction: 'sum',
        description: 'Share of physical memory in use.',
        unit: 'percent',
        sources: common.sources(
          'system_memory_utilization{%(queriesSelector)s, state="used"}',
          { legendCustomTemplate: '%(aggLegend)s', exprWrappers: [['100 * (', ')']] },
        ),
      },
      memoryUsageByState: {
        name: 'Memory by state',
        nameShort: 'Memory',
        type: 'gauge',
        aggFunction: 'sum',
        description: 'Physical memory broken down by state.',
        unit: 'bytes',
        sources: common.sources('system_memory_usage{%(queriesSelector)s}', { aggKeepLabels: ['state'] }),
      },
      memoryTotal: {
        name: 'Memory total',
        nameShort: 'Total',
        type: 'gauge',
        description: 'Total physical memory.',
        unit: 'bytes',
        sources: common.sources('system_memory_limit{%(queriesSelector)s}'),
      },
      memoryAvailable: {
        name: 'Memory available',
        nameShort: 'Available',
        type: 'gauge',
        description: 'Memory available to new allocations without swapping.',
        unit: 'bytes',
        sources: common.sources('system_linux_memory_available{%(queriesSelector)s}'),
      },
      memoryDirty: {
        name: 'Memory dirty',
        nameShort: 'Dirty',
        type: 'gauge',
        description: 'Memory waiting to be written back to disk.',
        unit: 'bytes',
        sources: common.sources('system_linux_memory_dirty{%(queriesSelector)s}'),
      },
      memoryShared: {
        name: 'Memory shared',
        nameShort: 'Shared',
        type: 'gauge',
        description: 'Memory shared between processes.',
        unit: 'bytes',
        sources: common.sources('system_memory_linux_shared{%(queriesSelector)s}'),
      },
      swapUsage: {
        name: 'Swap usage',
        nameShort: 'Swap',
        type: 'gauge',
        aggFunction: 'sum',
        description: 'Swap space by state.',
        unit: 'bytes',
        sources: common.sources('system_paging_usage{%(queriesSelector)s}', { aggKeepLabels: ['state'] }),
      },
      pagingOperations: {
        name: 'Memory pages swapping in / out',
        nameShort: 'Pages',
        type: 'counter',
        aggFunction: 'sum',
        description: 'Pages moved between memory and swap.',
        unit: 'ops',
        sources: common.sources('system_paging_operations{%(queriesSelector)s}', { aggKeepLabels: ['direction'], exprWrappers: [pagingCount] }),
      },
      pageFaults: {
        name: 'Memory page faults',
        nameShort: 'Faults',
        type: 'counter',
        aggFunction: 'sum',
        description: 'Minor and major page faults.',
        unit: 'ops',
        sources: common.sources('system_paging_faults{%(queriesSelector)s}', { aggKeepLabels: ['type'], exprWrappers: [pagingCount] }),
      },
      majorPageFaults: {
        name: 'Major page faults',
        nameShort: 'Major faults',
        type: 'counter',
        aggFunction: 'sum',
        description: 'Page faults that had to read from disk.',
        unit: 'ops',
        sources: common.sources('system_paging_faults{%(queriesSelector)s, type="major"}', { exprWrappers: [pagingCount] }),
      },
    },
  }
